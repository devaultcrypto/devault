#!/usr/bin/env bash
# shellcheck shell=bash
#
# DeVault V2 — Guix reproducible build driver.
# For each HOST, runs the per-host build.sh inside a hermetic, network-isolated
# Guix container pinned to GUIX_PIN. Adapted from Bitcoin Core's contrib/guix/guix-build.
#
# Usage:
#   ./contrib/guix/guix-build                      # build the full mandatory host set
#   HOSTS="x86_64-linux-gnu" ./contrib/guix/guix-build   # build a subset (dev)
#   GUIX_PIN=<commit> ./contrib/guix/guix-build
#
# PREREQUISITES (see DEVAULT_GUIX_IMPLEMENTATION_PLAN.md §4 / §5):
#   - Guix installed + guix-daemon running (G0).
#   - `make -C depends download` already run (the container has NO network).
#   - macOS SDK present under depends/SDKs/ for the darwin hosts (G4).
#
# DRAFT (2026-06-13): first scaffold. Validate against a live, pinned Guix before relying on it.

set -e -o pipefail

# shellcheck source=libexec/prelude.bash
source "$(dirname "${BASH_SOURCE[0]}")/libexec/prelude.bash"

HOSTS="${HOSTS:-$HOSTS_DEFAULT}"

if [ "${GUIX_PIN}" = "REPLACE_WITH_PINNED_GUIX_COMMIT" ]; then
    echo "ERROR: GUIX_PIN is not set. Run G0 4.5 (record \`guix describe\`) and set it in" >&2
    echo "       contrib/guix/libexec/prelude.bash, or pass GUIX_PIN=<commit>." >&2
    exit 1
fi

command -v guix >/dev/null 2>&1 || { echo "ERROR: guix not in PATH. Run G0 4.1-4.3." >&2; exit 1; }

# Guix build options applied to BOTH time-machine (builds the pinned inferior) and shell
# (builds the toolchain profile). --fallback: if a substitute server can't serve a store
# item, build it from source instead of hard-failing — resilient to substitute outages and
# strictly more reproducible. GUIX_SUBSTITUTE_URLS (optional): override the substitute
# servers, e.g. to skip an unreachable mirror. Leave unset to use the daemon's configured
# servers. (On hosts where ci.guix.gnu.org is firewalled, set it to bordeaux only.)
GUIX_BUILD_OPTS=( --fallback )
if [ -n "${GUIX_SUBSTITUTE_URLS:-}" ]; then
    GUIX_BUILD_OPTS+=( --substitute-urls="${GUIX_SUBSTITUTE_URLS}" )
fi

# The container is offline — fail early if depends sources were not pre-fetched.
if [ ! -d "${REPO_ROOT}/depends/sources" ]; then
    echo "ERROR: depends/sources/ missing. Run: make -C depends download   (G0 4.6)" >&2
    exit 1
fi

# The macOS SDK is proprietary and supplied by the builder. The source snapshot includes it
# from depends/SDKs, so reject a Darwin build before creating a container if it is missing.
for host in ${HOSTS}; do
    case "${host}" in
        *-apple-darwin23)
            SDK_PATH="${REPO_ROOT}/depends/SDKs/MacOSX14.5.sdk"
            if [ ! -d "${SDK_PATH}" ]; then
                echo "ERROR: macOS SDK missing at ${SDK_PATH}. Extract MacOSX14.5.sdk there before building Darwin targets." >&2
                exit 1
            fi
            ;;
    esac
done

# Build inputs that must NOT enter the clean source snapshot (regenerated in-container,
# or irrelevant dev junk). depends/sources is excluded here and hardlinked in separately
# (it is large; hardlinks are space-free on the same filesystem).
DISTSRC_EXCLUDES=(
    --exclude=./.git
    --exclude=./guix-build
    --exclude=./build
    --exclude='./build_*'
    --exclude=./depends/work
    --exclude=./depends/built
    --exclude=./depends/sources
    --exclude='./depends/x86_64-linux-gnu'
    --exclude='./depends/x86_64-w64-mingw32'
    --exclude='./depends/aarch64-linux-gnu'
    --exclude='./depends/*-apple-darwin*'
    --exclude='./*.dat'
    --exclude='./*.png'
)

# Make a clean, writable copy of the source tree for one host build. The container needs
# the tree writable (depends builds into depends/{work,built,<host>}); building from a
# fresh snapshot keeps the user's working tree clean and lets two runs be truly independent.
# Snapshot = current WORKING TREE (so uncommitted scaffolding is included during bring-up).
# TODO(release): switch to `git archive <tag>` for committed-only release reproducibility.
make_clean_distsrc() {
    local distsrc="$1"
    rm -rf "${distsrc}"
    mkdir -p "${distsrc}"
    # --no-wildcards-match-slash: GNU tar lets `*` cross `/` in --exclude by default, so the
    # top-level-only patterns './*.png' / './*.dat' would otherwise also match src/qt/res/icons/
    # *.png (72 real GUI icons) and any nested *.dat fixtures. Anchor them to the root.
    tar -C "${REPO_ROOT}" --no-wildcards-match-slash "${DISTSRC_EXCLUDES[@]}" -cf - . | tar -C "${distsrc}" -xf -
    # Hardlink the pre-fetched source cache in (offline container reads it from here).
    mkdir -p "${distsrc}/depends"
    cp -al "${REPO_ROOT}/depends/sources" "${distsrc}/depends/sources"
}

# Build (once, cached + GC-rooted) the native-helper profile for a pin: native gcc-toolchain +
# native-build-deps. CROSS-host builds source this in build.sh ONLY for BCHN's NativeExecutable
# sub-build, keeping the native glibc/libstdc++ OUT of the cross build's profile (else they win
# the include/lib collision and break the cross compile/link). Echoes the resolved /gnu/store
# profile path — accessible inside the container since the store is auto-mounted there.
ensure_native_helper() {
    local pin="$1"
    local link="${REPO_ROOT}/guix-build/gcroots/native-helper-${pin:0:12}"
    if [ ! -e "${link}" ]; then
        echo "    building native-helper profile (native gcc + deps) for pin ${pin:0:12} ..." >&2
        mkdir -p "$(dirname "${link}")"
        GUIX_MANIFEST_ROLE=native-helper \
            guix time-machine --commit="${pin}" "${GUIX_BUILD_OPTS[@]}" -- \
                package -m "${GUIX_ROOT}/manifest.scm" -p "${link}" \
                "${GUIX_BUILD_OPTS[@]}" >&2 || return 1
    fi
    readlink -f "${link}"
}

echo "DeVault V2 reproducible build"
echo "  version      : ${VERSION}"
echo "  guix pin     : ${GUIX_PIN}  (linux: ${GUIX_PIN_LINUX})"
echo "  source epoch : ${SOURCE_DATE_EPOCH}"
echo "  hosts        : ${HOSTS}"
echo "  output base  : ${OUTDIR_BASE}"
echo

for HOST in ${HOSTS}; do
    OUTDIR="${OUTDIR_BASE}/${HOST}"
    DISTSRC="${REPO_ROOT}/guix-build/distsrc/${HOST}"
    HOST_PIN="$(guix_pin_for_host "${HOST}")"
    # Persistent depends build-cache, OUTSIDE the (rm -rf'd each run) snapshot so built
    # packages survive across runs. KEYED BY (host, pin): depends built under a different Guix
    # toolchain (e.g. a different glibc) must NOT be reused, or it would silently contaminate
    # the glibc floor. DISTSRC is a stable per-host path so absolute paths in cached artifacts
    # stay valid. Delete the dir for a from-scratch build.
    DEPENDS_CACHE="${REPO_ROOT}/guix-build/depends-cache/${HOST}-${HOST_PIN:0:12}"
    mkdir -p "${OUTDIR}" "${DEPENDS_CACHE}"
    echo "==> Building ${HOST}  ->  ${OUTDIR}   (guix pin ${HOST_PIN:0:12})"

    echo "    preparing clean source snapshot: ${DISTSRC}"
    make_clean_distsrc "${DISTSRC}"

    # CROSS hosts get a SEPARATE native-helper profile (native gcc + deps) for BCHN's native
    # sub-build; the native host (x86_64-linux-gnu) has no cross toolchain → no contamination →
    # no helper needed (everything stays in its single build profile).
    NATIVE_HELPER=""
    HELPER_EXPOSE=()
    if [ "${HOST}" != "x86_64-linux-gnu" ]; then
        NATIVE_HELPER="$(ensure_native_helper "${HOST_PIN}")"
        # The helper profile is OUTSIDE the container's manifest closure, so `guix --container`
        # won't mount it. Expose its full store closure (~30 paths) read-only — else its gcc/libs
        # are unmounted dangling symlinks. (Paths already in the manifest closure are deduped.)
        while IFS= read -r _p; do HELPER_EXPOSE+=( --expose="${_p}" ); done \
            < <(guix gc --requisites "${NATIVE_HELPER}" 2>/dev/null)
    fi

    # Export HOST so manifest.scm's (getenv "HOST") selects this host's toolchain when the
    # host-side `guix` evaluates the manifest (before the container is created).
    export HOST

    # time-machine pins the exact Guix (toolchain bytes); shell --container isolates;
    # The container's default no-network enforces the offline contract. DISTSRC + OUTDIR are
    # shared read-WRITE (depends/cmake/ninja write into the snapshot; artifacts land in OUTDIR).
    # NB: `guix shell --container` disables network BY DEFAULT (offline as required);
    # there is no `--network=no` — passing `--network` would ENABLE it. So we omit it.
    # --emulate-fhs: populate /usr/bin/env, /bin/sh, /lib, ... from the profile. Required:
    # several depends configure scripts/shebangs assume an FHS layout (e.g. openssl's
    # ./Configure is `#!/usr/bin/env perl`), and the container root is read-only + non-root.
    # --rebuild-cache is REQUIRED: `guix shell -m manifest.scm` caches the computed profile
    # keyed by the manifest FILE, NOT by the HOST env var the manifest reads — so without it a
    # second host would silently reuse the first host's profile. Re-eval is cheap (packages stay
    # store-cached); it only recomputes which packages the profile contains for this HOST.
    guix time-machine --commit="${HOST_PIN}" "${GUIX_BUILD_OPTS[@]}" -- \
        shell --container --emulate-fhs --no-cwd --pure --rebuild-cache \
            "${GUIX_BUILD_OPTS[@]}" \
            --share="${DISTSRC}" \
            --share="${OUTDIR}" \
            --share="${DEPENDS_CACHE}" \
            "${HELPER_EXPOSE[@]}" \
            --manifest="${GUIX_ROOT}/manifest.scm" \
            -- env \
                HOST="${HOST}" \
                OUTDIR="${OUTDIR}" \
                REPO_ROOT="${DISTSRC}" \
                DEPENDS_BASE_CACHE="${DEPENDS_CACHE}" \
                VERSION="${VERSION}" \
                DISTNAME="${DISTNAME}" \
                SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH}" \
                GUIX_NO_QT="${GUIX_NO_QT:-0}" \
                JOBS="${JOBS:-$(nproc)}" \
                NATIVE_HELPER_PROFILE="${NATIVE_HELPER}" \
                TZ="UTC" LC_ALL="C" \
                bash "${DISTSRC}/contrib/guix/libexec/build.sh" "${HOST}"

    echo "==> Done ${HOST}"
    echo
done

echo "All hosts built. Next: ./contrib/guix/guix-attest to produce SHA256SUMS(.asc)."
